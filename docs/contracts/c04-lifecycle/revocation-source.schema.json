{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafseamer.invalid/contracts/c04-lifecycle/revocation-source.schema.json",
  "x-approved": false,
  "x-runtime-approved": false,
  "not": {},
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
    },
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$(?![\\s\\S])"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "Binding": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "controller_boot_id": {
          "$ref": "#/$defs/Id"
        },
        "worker_boot_id": {
          "$ref": "#/$defs/Id"
        },
        "writer_exit_id": {
          "$ref": "#/$defs/Id"
        },
        "ipc_session_id": {
          "$ref": "#/$defs/Id"
        },
        "device_id": {
          "$ref": "#/$defs/Id"
        },
        "device_session_id": {
          "$ref": "#/$defs/Id"
        },
        "clock_domain_id": {
          "type": "string",
          "pattern": "^clock_[0-9a-f]{64}$(?![\\s\\S])"
        },
        "descriptor_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "scope",
        "controller_boot_id",
        "worker_boot_id",
        "writer_exit_id",
        "ipc_session_id",
        "device_id",
        "device_session_id",
        "clock_domain_id",
        "descriptor_digest"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "authority_service_id": {
          "$ref": "#/$defs/Id"
        },
        "database_instance_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "authority_service_id",
        "database_instance_id"
      ],
      "additionalProperties": false
    },
    "AuthorizationBinding": {
      "type": "object",
      "properties": {
        "issuer_id": {
          "$ref": "#/$defs/Id"
        },
        "issuer_epoch": {
          "$ref": "#/$defs/Id"
        },
        "audience": {
          "$ref": "#/$defs/Id"
        },
        "principal_kind": {
          "enum": [
            "human",
            "service"
          ]
        },
        "principal_id": {
          "$ref": "#/$defs/Id"
        },
        "origin": {
          "enum": [
            "manual",
            "automation"
          ]
        },
        "session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "credential_id": {
          "$ref": "#/$defs/Id"
        },
        "subject_revision": {
          "$ref": "#/$defs/Revision"
        },
        "session_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_revision": {
          "$ref": "#/$defs/Revision"
        },
        "scope_digest": {
          "$ref": "#/$defs/Digest"
        },
        "grant_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "grant_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "arm_generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "extension_instance_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "extension_approval_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "issuer_id",
        "issuer_epoch",
        "audience",
        "principal_kind",
        "principal_id",
        "origin",
        "session_id",
        "credential_id",
        "subject_revision",
        "session_revision",
        "policy_revision",
        "scope_digest",
        "grant_id",
        "grant_revision",
        "arm_generation",
        "extension_instance_id",
        "extension_approval_revision"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "principal_kind": {
                "const": "human"
              }
            },
            "required": [
              "principal_kind"
            ]
          },
          "then": {
            "properties": {
              "session_id": {
                "$ref": "#/$defs/Id"
              },
              "session_revision": {
                "$ref": "#/$defs/Revision"
              },
              "origin": {
                "const": "manual"
              }
            }
          },
          "else": {
            "properties": {
              "session_id": {
                "type": "null"
              },
              "session_revision": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "automation"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "properties": {
              "principal_kind": {
                "const": "service"
              },
              "grant_id": {
                "$ref": "#/$defs/Id"
              },
              "grant_revision": {
                "$ref": "#/$defs/Revision"
              },
              "arm_generation": {
                "$ref": "#/$defs/Revision"
              }
            }
          },
          "else": {
            "properties": {
              "grant_id": {
                "type": "null"
              },
              "grant_revision": {
                "type": "null"
              },
              "arm_generation": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "extension_instance_id": {
                "type": "null"
              }
            },
            "required": [
              "extension_instance_id"
            ]
          },
          "then": {
            "properties": {
              "extension_approval_revision": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "extension_approval_revision": {
                "$ref": "#/$defs/Revision"
              }
            }
          }
        }
      ]
    },
    "Revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$(?![\\s\\S])"
    },
    "Dependency": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "principal",
            "session",
            "credential",
            "grant",
            "extension",
            "trust"
          ]
        },
        "target_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "target_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "Member": {
      "type": "object",
      "properties": {
        "sequence": {
          "$ref": "#/$defs/Counter"
        },
        "event_ref": {
          "$ref": "#/$defs/Ref"
        },
        "denial": {
          "enum": [
            null,
            "below_floor",
            "credential_revoked",
            "issuer_epoch_revoked"
          ]
        }
      },
      "required": [
        "sequence",
        "event_ref",
        "denial"
      ],
      "additionalProperties": false
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": "authorization-revocation-source/0.1.0-draft.1"
        },
        "snapshot_id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "const": "1"
        },
        "source_use_ref": {
          "$ref": "#/$defs/Ref"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "authorization_binding": {
          "$ref": "#/$defs/AuthorizationBinding"
        },
        "dependencies": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/Dependency"
          }
        },
        "observed_through": {
          "$ref": "#/$defs/Counter"
        },
        "members": {
          "type": "array",
          "maxItems": 24576,
          "items": {
            "$ref": "#/$defs/Member"
          }
        },
        "observed_floor_result": {
          "enum": [
            "denied",
            "no_matching_denial"
          ]
        },
        "snapshot_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "format_version",
        "snapshot_id",
        "revision",
        "source_use_ref",
        "binding",
        "authorization_binding",
        "dependencies",
        "observed_through",
        "members",
        "observed_floor_result",
        "snapshot_digest"
      ],
      "additionalProperties": false
    }
  }
}
