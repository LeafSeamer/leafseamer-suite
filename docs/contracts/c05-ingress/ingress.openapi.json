  "components": {
    "schemas": {
      "Id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
      },
      "ProviderReceipt": {
        "type": "object",
        "properties": {
          "contract_version": {
            "const": "event-ingress/0.1.0-draft.1"
          },
          "receipt_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
          },
          "receipt_revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}(?![\\s\\S])"
          },
          "source_key": {
            "$ref": "#/components/schemas/SourceKey"
          },
          "event_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
          },
          "origin_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
          },
          "ingest_state": {
            "const": "committed"
          },
          "duplicate": {
            "type": "boolean"
          }
        },
        "required": [
          "contract_version",
          "receipt_id",
          "receipt_revision",
          "source_key",
          "event_id",
          "origin_digest",
          "ingest_state",
          "duplicate"
        ],
        "additionalProperties": false
      },
      "SourceKey": {
        "type": "object",
        "properties": {
          "authority_service_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
          },
          "database_instance_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
          },
          "registration_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
          },
          "source_stream_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
          },
          "source_epoch": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
          }
        },
        "required": [
          "authority_service_id",
          "database_instance_id",
          "registration_id",
          "source_stream_id",
          "source_epoch"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "forbidden",
              "invalid",
              "conflict",
              "closed",
              "capacity",
              "unavailable",
              "version"
            ]
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
          }
        },
        "required": [
          "code",
          "request_id"
        ],
        "additionalProperties": false
      },
      "SubmitEvent": {
        "type": "object",
        "properties": {
          "contract_version": {
            "const": "event-ingress/0.1.0-draft.1"
          },
          "origin": {
            "$ref": "#/components/schemas/Origin"
          },
          "origin_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
          },
          "delivery_binding_ref": {
            "$ref": "#/components/schemas/Ref"
          },
          "age_evidence_ref": {
            "$ref": "#/components/schemas/Ref"
          }
        },
        "required": [
          "contract_version",
          "origin",
          "origin_digest",
          "delivery_binding_ref",
          "age_evidence_ref"
        ],
        "additionalProperties": false
      },
      "Origin": {
        "type": "object",
        "properties": {
          "source_key": {
            "$ref": "#/components/schemas/SourceKey"
          },
          "binding_ref": {
            "$ref": "#/components/schemas/SourceBindingRef"
          },
          "event_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
          },
          "source_sequence": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}(?![\\s\\S])"
