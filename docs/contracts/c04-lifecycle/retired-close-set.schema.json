{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafseamer.invalid/contracts/c04-lifecycle/retired-close-set.schema.json",
  "$defs": {
    "RetiredCloseSet": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": "retired-close-set/0.1.0-draft.1"
        },
        "completion_id": {
          "$ref": "https://leafseamer.invalid/design/df02-supervisor/supervisor.schema.json#/$defs/Id"
        },
        "revision": {
          "const": "1"
        },
        "anchor_exit_id": {
          "$ref": "https://leafseamer.invalid/design/df02-supervisor/supervisor.schema.json#/$defs/Id"
        },
        "worker_identity_digest": {
          "$ref": "https://leafseamer.invalid/design/df02-supervisor/supervisor.schema.json#/$defs/Digest"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "properties": {
              "binding": {
                "$ref": "https://leafseamer.invalid/design/c08-controller/encoding-authority.schema.json#/$defs/Binding"
              },
              "runtime_binding_ref": {
                "$ref": "https://leafseamer.invalid/design/c08-controller/encoding-authority.schema.json#/$defs/Ref"
              },
              "retirement_adoption_ref": {
                "$ref": "https://leafseamer.invalid/design/c08-controller/encoding-authority.schema.json#/$defs/Ref"
              },
              "close_ref": {
                "$ref": "https://leafseamer.invalid/design/c08-controller/encoding-authority.schema.json#/$defs/Ref"
              },
              "cut_ref": {
                "$ref": "https://leafseamer.invalid/design/c08-controller/encoding-authority.schema.json#/$defs/Ref"
              },
              "prepare_head": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "preparations": {
                "type": "array",
                "maxItems": 4096,
                "items": {
                  "type": "object",
                  "properties": {
                    "prepare_id": {
                      "$ref": "https://leafseamer.invalid/design/df02-supervisor/supervisor.schema.json#/$defs/Id"
                    },
                    "encoding_authorization_ref": {
                      "$ref": "https://leafseamer.invalid/design/c08-controller/encoding-authority.schema.json#/$defs/Ref"
                    },
                    "revocation_ref": {
                      "$ref": "https://leafseamer.invalid/design/c08-controller/encoding-authority.schema.json#/$defs/Ref"
                    },
                    "encoding_frame_ref": {
                      "$ref": "https://leafseamer.invalid/design/c08-controller/encoding-authority.schema.json#/$defs/Ref"
                    },
                    "basis": {
                      "const": "retired"
                    }
                  },
                  "required": [
                    "prepare_id",
                    "encoding_authorization_ref",
                    "revocation_ref",
                    "encoding_frame_ref",
                    "basis"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "binding",
              "runtime_binding_ref",
              "retirement_adoption_ref",
              "close_ref",
              "cut_ref",
              "prepare_head",
              "preparations"
            ],
            "additionalProperties": false
          }
        },
        "completion_digest": {
          "$ref": "https://leafseamer.invalid/design/df02-supervisor/supervisor.schema.json#/$defs/Digest"
        }
      },
      "required": [
        "format_version",
        "completion_id",
        "revision",
        "anchor_exit_id",
        "worker_identity_digest",
        "targets",
        "completion_digest"
      ],
      "additionalProperties": false
    }
  }
}
