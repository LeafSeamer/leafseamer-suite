  "components": {
    "schemas": {
      "S0_PreparationRecord": {
        "type": "object",
        "properties": {
          "request": {
            "$ref": "#/components/schemas/S0_PrepareRequest"
          },
          "request_digest": {
            "$ref": "#/components/schemas/S0_Digest"
          },
          "revision": {
            "$ref": "#/components/schemas/S0_PositiveCounter"
          },
          "state": {
            "enum": [
              "accepted",
              "applied",
              "rejected",
              "indeterminate",
              "closing",
              "closed"
            ]
          },
          "applied_receipt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/S0_PreparationReceipt"
              },
              {
                "type": "null"
              }
            ]
          },
          "protection_ref": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/S0_ProtectionRef"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "request",
          "request_digest",
          "revision",
          "state",
          "applied_receipt",
          "protection_ref"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "applied"
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "properties": {
                "applied_receipt": {
                  "$ref": "#/components/schemas/S0_PreparationReceipt"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "accepted",
                    "rejected"
                  ]
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "properties": {
                "applied_receipt": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "closed"
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "properties": {
                "protection_ref": {
                  "$ref": "#/components/schemas/S0_ProtectionRef"
                }
              }
            }
          }
        ]
      },
      "S0_PrepareRequest": {
        "type": "object",
        "properties": {
          "contract_version": {
            "const": "automation-preparation/0.1.0-draft.1"
          },
          "operation_id": {
            "$ref": "#/components/schemas/S0_Id"
          },
          "preparation_id": {
            "$ref": "#/components/schemas/S0_Id"
          },
          "controller_scope": {
            "$ref": "#/components/schemas/S0_Scope"
          },
          "origin_scope": {
            "$ref": "#/components/schemas/S0_Scope"
          },
          "run_id": {
            "$ref": "#/components/schemas/S0_Id"
          },
          "definition_version": {
            "$ref": "#/components/schemas/S0_PositiveCounter"
          },
          "arm_generation": {
            "$ref": "#/components/schemas/S0_PositiveCounter"
          },
          "mode": {
            "enum": [
              "arm",
              "recovery"
            ]
          },
          "execution_id": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/S0_Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "operation_ref": {
            "$ref": "#/components/schemas/S0_OperationRef"
          },
          "plan_ref": {
            "$ref": "#/components/schemas/S0_PlanRef"
          },
          "artifact_ref": {
            "$ref": "#/components/schemas/S0_ArtifactRef"
          },
          "approval_ref": {
            "$ref": "#/components/schemas/S0_ApprovalRef"
          },
          "authorization_digest": {
            "$ref": "#/components/schemas/S0_Digest"
          },
          "source_digest": {
            "$ref": "#/components/schemas/S0_Digest"
          },
          "controls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/S0_ControlExpectation"
            },
            "minItems": 1,
            "maxItems": 256
          },
          "baseline_grant_ref": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/S0_GrantRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "grant_intent": {
            "$ref": "#/components/schemas/S0_GrantIntent"
          }
        },
        "required": [
          "contract_version",
          "operation_id",
          "preparation_id",
          "controller_scope",
          "origin_scope",
          "run_id",
          "definition_version",
          "arm_generation",
          "mode",
          "execution_id",
          "operation_ref",
          "plan_ref",
          "artifact_ref",
          "approval_ref",
          "authorization_digest",
          "source_digest",
          "controls",
          "baseline_grant_ref",
          "grant_intent"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "arm"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "properties": {
                "execution_id": {
                  "type": "null"
                },
                "plan_ref": {
                  "properties": {
                    "kind": {
                      "const": "arm_plan"
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "execution_id": {
                  "$ref": "#/components/schemas/S0_Id"
                },
                "plan_ref": {
                  "properties": {
                    "kind": {
                      "const": "recovery_plan"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "S0_Id": {
        "$ref": "#/components/schemas/S1_Id"
      },
      "S1_Id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
      },
      "S0_Scope": {
        "$ref": "#/components/schemas/S1_Scope"
      },
      "S1_Scope": {
        "type": "object",
        "properties": {
          "authority_service_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
          },
          "database_instance_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
          }
        },
        "required": [
          "authority_service_id",
          "database_instance_id"
        ],
        "additionalProperties": false
      },
      "S0_PositiveCounter": {
        "$ref": "#/components/schemas/S1_PositiveCounter"
      },
      "S1_PositiveCounter": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,19}(?![\\s\\S])"
      },
      "S0_OperationRef": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "lifecycle_operation"
          },
          "scope": {
            "$ref": "#/components/schemas/S0_Scope"
          },
          "object_id": {
            "$ref": "#/components/schemas/S0_Id"
          },
          "revision": {
            "$ref": "#/components/schemas/S0_Counter"
          },
          "digest": {
            "$ref": "#/components/schemas/S0_Digest"
          }
        },
        "required": [
          "kind",
          "scope",
          "object_id",
          "revision",
          "digest"
        ],
        "additionalProperties": false
      },
      "S0_Counter": {
        "$ref": "#/components/schemas/S1_Counter"
      },
      "S1_Counter": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
      },
      "S0_Digest": {
        "$ref": "#/components/schemas/S1_Digest"
      },
      "S1_Digest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
      },
      "S0_PlanRef": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "arm_plan",
              "recovery_plan"
            ]
          },
          "scope": {
            "$ref": "#/components/schemas/S0_Scope"
          },
          "object_id": {
            "$ref": "#/components/schemas/S0_Id"
          },
