{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:leafseamer:design:snapshot-projection/0.1.0-draft.1",
  "title": "完整快照投影候选；合法结构不证明权限、采样或持久交接",
  "oneOf": [
    {
      "$ref": "#/$defs/Manifest"
    },
    {
      "$ref": "#/$defs/PageResponse"
    },
    {
      "$ref": "#/$defs/Data"
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])",
      "maxLength": 128
    },
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])",
      "maxLength": 20
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "maxLength": 64
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "ObjectRef": {
      "type": "object",
      "properties": {
        "authority_service_id": {
          "$ref": "#/$defs/Id"
        },
        "database_instance_id": {
          "$ref": "#/$defs/Id"
        },
        "entity_kind": {
          "$ref": "#/$defs/Id"
        },
        "entity_id": {
          "$ref": "#/$defs/Id"
        },
        "entity_epoch": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "content_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "authority_service_id",
        "database_instance_id",
        "entity_kind",
        "entity_id",
        "entity_epoch",
        "revision",
        "content_digest"
      ],
      "additionalProperties": false
    },
    "SchemaRef": {
      "type": "object",
      "properties": {
        "schema_id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "definition": {
          "$ref": "#/$defs/Id"
        },
        "schema_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "schema_id",
        "definition",
        "schema_digest"
      ],
      "additionalProperties": false
    },
    "DomainRef": {
      "type": "object",
      "properties": {
        "clock_domain_id": {
          "type": "string",
          "pattern": "^clock_[0-9a-f]{64}(?![\\s\\S])"
        },
        "descriptor_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "clock_domain_id",
        "descriptor_digest"
      ],
      "additionalProperties": false
    },
    "SourceKey": {
      "type": "object",
      "properties": {
        "authority_service_id": {
          "$ref": "#/$defs/Id"
        },
        "database_instance_id": {
          "$ref": "#/$defs/Id"
        },
        "registration_id": {
          "$ref": "#/$defs/Id"
        },
        "source_stream_id": {
          "$ref": "#/$defs/Id"
        },
        "source_epoch": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "authority_service_id",
        "database_instance_id",
        "registration_id",
        "source_stream_id",
        "source_epoch"
      ],
      "additionalProperties": false
    },
    "Gap": {
      "type": "object",
      "properties": {
        "gap_id": {
          "$ref": "#/$defs/Id"
        },
        "loss_extent": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "first_missing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_missing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution_state": {
          "enum": [
            "open",
            "acknowledged",
            "baseline_replaced"
          ]
        }
      },
      "required": [
        "gap_id",
        "loss_extent",
        "first_missing",
        "last_missing",
        "resolution_state"
      ],
      "additionalProperties": false
    },
    "QualifiedValue": {
      "type": "object",
      "properties": {
        "schema_ref": {
          "$ref": "#/$defs/SchemaRef"
        },
        "value": {}
      },
      "required": [
        "schema_ref",
        "value"
      ],
      "additionalProperties": false
    },
    "RequestLink": {
      "type": "object",
      "properties": {
        "service_id": {
          "$ref": "#/$defs/Id"
        },
        "context_epoch": {
          "$ref": "#/$defs/Id"
        },
        "context_id": {
          "$ref": "#/$defs/Id"
        },
        "principal_id": {
          "$ref": "#/$defs/Id"
        },
        "idempotency_key": {
          "$ref": "#/$defs/Id"
        },
        "operation": {
          "$ref": "#/$defs/Id"
        },
        "issuer_id": {
          "$ref": "#/$defs/Id"
        },
        "issuer_epoch": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "service_id",
        "context_epoch",
        "context_id",
        "principal_id",
        "idempotency_key",
        "operation",
        "issuer_id",
        "issuer_epoch"
      ],
      "additionalProperties": false
    },
    "PendingControl": {
      "type": "object",
      "properties": {
        "operation_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "target_version": {
          "$ref": "#/$defs/Counter"
        },
        "target_holder_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_mode": {
          "enum": [
            "manual",
            "automatic"
          ]
        },
        "state": {
          "enum": [
            "pending",
            "effective",
            "rejected",
            "indeterminate"
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "operation_ref",
        "target_version",
        "target_holder_id",
        "target_mode",
        "state",
        "reason_code"
      ],
      "additionalProperties": false
    },
    "Transfer": {
      "type": "object",
      "properties": {
        "transfer_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "from_principal_id": {
          "$ref": "#/$defs/Id"
        },
        "target_principal_id": {
          "$ref": "#/$defs/Id"
        },
        "expected_control_epoch": {
          "$ref": "#/$defs/Id"
        },
        "expected_effective_version": {
          "$ref": "#/$defs/Counter"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "state": {
          "enum": [
            "offered",
            "accepted",
            "expired",
            "cancelled"
          ]
        },
        "accept_operation_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "transfer_ref",
        "from_principal_id",
        "target_principal_id",
        "expected_control_epoch",
        "expected_effective_version",
        "expires_at",
        "state",
        "accept_operation_ref"
      ],
      "additionalProperties": false
    },
    "Recovery": {
      "type": "object",
      "properties": {
        "operation_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "state": {
          "enum": [
            "reserved",
            "preparing",
            "ready",
            "running",
            "completed",
            "paused",
            "indeterminate"
          ]
        },
        "recovery_generation": {
          "$ref": "#/$defs/Counter"
        },
        "new_execution_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "consumed": {
          "const": true
        }
      },
      "required": [
        "operation_ref",
        "state",
        "recovery_generation",
        "new_execution_ref",
        "consumed"
      ],
      "additionalProperties": false
    },
    "Step": {
      "type": "object",
      "properties": {
        "step_id": {
          "$ref": "#/$defs/Id"
        },
        "required": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "unknown",
            "blocked",
            "cancelled"
          ]
        },
        "command_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "maxItems": 256
        }
      },
      "required": [
        "step_id",
        "required",
        "state",
        "command_ref",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "DeviceSnapshotView": {
      "type": "object",
      "properties": {
        "device_kind": {
          "$ref": "#/$defs/Id"
        },
        "display_name": {
          "type": "string",
          "maxLength": 1024
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "firmware": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "connection_state": {
          "enum": [
            "disconnected",
            "connecting",
            "ready",
            "faulted"
          ]
        },
        "observation_quality": {
          "enum": [
            "fresh",
            "stale",
            "unavailable"
          ]
        },
        "catalog_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "device_kind",
        "display_name",
        "model",
        "firmware",
        "connection_state",
        "observation_quality",
        "catalog_ref"
      ],
      "additionalProperties": false
    },
    "CatalogSnapshotView": {
      "type": "object",
      "properties": {
        "device_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "approval_state": {
          "enum": [
            "approved",
            "unavailable",
            "revoked"
          ]
        },
        "capability_revision": {
          "$ref": "#/$defs/Counter"
        },
        "capability_digest": {
          "$ref": "#/$defs/Digest"
        },
        "action_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 256
        },
        "trigger_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 256
        },
        "catalog_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "device_ref",
        "approval_state",
        "capability_revision",
        "capability_digest",
        "action_ids",
        "trigger_ids",
        "catalog_ref",
        "unavailable_reason"
      ],
      "additionalProperties": false
    },
    "CommandSnapshotView": {
      "type": "object",
      "properties": {
        "device_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "action_id": {
          "$ref": "#/$defs/Id"
        },
        "capability_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "request_ref": {
          "$ref": "#/$defs/RequestLink"
        },
        "origin": {
          "enum": [
            "manual",
            "automation"
          ]
        },
        "accepted_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "phase": {
          "enum": [
            "queued",
            "dispatching",
            "awaiting_evidence",
            "finished"
          ]
        },
        "outcome": {
          "enum": [
            "pending",
            "succeeded",
            "failed",
            "unknown",
            "cancelled",
            "expired",
            "blocked"
          ]
        },
        "effect_status": {
          "enum": [
            "not_sent",
            "possible",
            "acknowledged",
            "verified",
            "partial"
          ]
        },
        "resource_status": {
          "enum": [
            "held",
            "clear",
            "unresolved"
          ]
        },
        "control_epoch": {
          "$ref": "#/$defs/Id"
        },
        "effective_version": {
          "$ref": "#/$defs/Counter"
        },
        "completion_required": {
          "enum": [
            "sent",
            "acknowledged",
            "effect_verified"
          ]
        },
        "completion_achieved": {
          "anyOf": [
            {
              "enum": [
                "sent",
                "acknowledged",
                "effect_verified"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_policy_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "maxItems": 256
        },
        "cancellation_state": {
          "enum": [
            "none",
            "requested",
            "confirmed",
            "unsupported",
            "failed"
          ]
        },
        "cancellation_operation_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "device_ref",
        "action_id",
        "capability_version",
        "request_ref",
        "origin",
        "accepted_at",
        "phase",
        "outcome",
        "effect_status",
        "resource_status",
        "control_epoch",
        "effective_version",
        "completion_required",
        "completion_achieved",
        "evidence_policy_ref",
        "reason_code",
        "evidence_refs",
        "cancellation_state",
        "cancellation_operation_ref",
        "resolution_ref"
      ],
      "additionalProperties": false
    },
    "ControlSnapshotView": {
      "type": "object",
      "properties": {
        "device_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "control_epoch": {
          "$ref": "#/$defs/Id"
        },
        "effective_version": {
          "$ref": "#/$defs/Counter"
        },
        "effective_holder_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "enum": [
            "manual",
            "automatic"
          ]
        },
        "gate_state": {
          "enum": [
            "ready",
            "fencing",
            "protected"
          ]
        },
        "pending_change": {
          "anyOf": [
            {
              "$ref": "#/$defs/PendingControl"
            },
            {
              "type": "null"
            }
          ]
        },
        "transfers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Transfer"
          },
          "maxItems": 32
        },
        "in_flight_commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "maxItems": 256
        },
        "unresolved_commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "maxItems": 256
        }
      },
      "required": [
        "device_ref",
        "control_epoch",
        "effective_version",
        "effective_holder_id",
        "mode",
        "gate_state",
        "pending_change",
        "transfers",
        "in_flight_commands",
        "unresolved_commands"
      ],
      "additionalProperties": false
    },
    "ObservationSnapshotView": {
      "type": "object",
      "properties": {
        "device_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "source_key": {
          "$ref": "#/$defs/SourceKey"
        },
        "provider_boot_id": {
          "$ref": "#/$defs/Id"
        },
        "device_session_id": {
          "$ref": "#/$defs/Id"
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "sampling_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "freshness_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "quality": {
          "enum": [
            "fresh",
            "stale",
            "unavailable"
          ]
        },
        "integrity": {
          "enum": [
            "complete",
            "gap",
            "unavailable"
          ]
        },
        "values": {
          "$ref": "#/$defs/QualifiedValue"
        }
      },
      "required": [
        "device_ref",
        "source_key",
        "provider_boot_id",
        "device_session_id",
        "observed_at",
        "sampling_ref",
        "freshness_ms",
        "quality",
        "integrity",
        "values"
      ],
      "additionalProperties": false
    },
    "SourceSnapshotView": {
      "type": "object",
      "properties": {
        "source_key": {
          "$ref": "#/$defs/SourceKey"
        },
        "binding_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "state": {
          "enum": [
            "baseline_required",
            "synchronized",
            "desynchronized",
            "quarantined",
            "closed"
          ]
        },
        "contiguous_sequence": {
          "$ref": "#/$defs/Counter"
        },
        "highest_seen_sequence": {
          "$ref": "#/$defs/Counter"
        },
        "baseline_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Gap"
          },
          "maxItems": 64
        }
      },
      "required": [
        "source_key",
        "binding_ref",
        "state",
        "contiguous_sequence",
        "highest_seen_sequence",
        "baseline_ref",
        "gaps"
      ],
      "additionalProperties": false
    },
    "DefinitionSnapshotView": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string",
          "maxLength": 1024
        },
        "published_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "draft_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "activation_state": {
          "enum": [
            "inactive",
            "active",
            "retired"
          ]
        }
      },
      "required": [
        "display_name",
        "published_ref",
        "draft_revision",
        "activation_state"
      ],
      "additionalProperties": false
    },
    "RunSnapshotView": {
      "type": "object",
      "properties": {
        "definition_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "business_state_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "arm_generation": {
          "$ref": "#/$defs/Counter"
        },
        "lifecycle": {
          "enum": [
            "disarmed",
            "armed",
            "running",
            "paused",
            "completed"
          ]
        },
        "execution_summary": {
          "enum": [
            "pending",
            "succeeded",
            "completed_with_failures",
            "failed",
            "unknown",
            "blocked"
          ]
        },
        "active_execution_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "pause_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 64
        },
        "authorization_state": {
          "enum": [
            "valid",
            "pending",
            "revoked",
            "expired",
            "unavailable"
          ]
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recovery"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "definition_ref",
        "business_state_ref",
        "arm_generation",
        "lifecycle",
        "execution_summary",
        "active_execution_ref",
        "pause_reasons",
        "authorization_state",
        "recovery"
      ],
      "additionalProperties": false
    },
    "BusinessStateSnapshotView": {
      "type": "object",
      "properties": {
        "run_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "state_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_transition_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "active_execution_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
