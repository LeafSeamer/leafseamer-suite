{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafseamer.invalid/contracts/c04-lifecycle/recovery-close-choice.schema.json",
  "$defs": {
    "RecoveryCloseChoice": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": "recovery-close-choice/0.1.0-draft.1"
        },
        "recovery_id": {
          "$ref": "https://leafseamer.invalid/design/df02-supervisor/supervisor.schema.json#/$defs/Id"
        },
        "revision": {
          "const": "1"
        },
        "binding": {
          "$ref": "https://leafseamer.invalid/design/c08-controller/encoding-authority.schema.json#/$defs/Binding"
        },
        "snapshot_ref": {
          "$ref": "https://leafseamer.invalid/design/c08-controller/encoding-authority.schema.json#/$defs/Ref"
        },
        "provider_ref": {
          "$ref": "https://leafseamer.invalid/design/c08-controller/encoding-authority.schema.json#/$defs/Ref"
        },
        "selected_tick_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "worker_ack"
                  },
                  "close_ref": {
                    "$ref": "https://leafseamer.invalid/design/c08-controller/encoding-authority.schema.json#/$defs/Ref"
                  },
                  "ack_ref": {
                    "$ref": "https://leafseamer.invalid/design/c08-controller/encoding-authority.schema.json#/$defs/Ref"
                  },
                  "preparation_closure_ref": {
                    "$ref": "https://leafseamer.invalid/design/c08-controller/encoding-authority.schema.json#/$defs/Ref"
                  }
                },
                "required": [
                  "kind",
                  "close_ref",
                  "ack_ref",
                  "preparation_closure_ref"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "supervisor_retired"
                  },
                  "close_ref": {
                    "$ref": "https://leafseamer.invalid/design/c08-controller/encoding-authority.schema.json#/$defs/Ref"
                  },
                  "retired_completion_ref": {
                    "$ref": "https://leafseamer.invalid/design/c08-controller/encoding-authority.schema.json#/$defs/Ref"
                  },
                  "writer_exit_id": {
                    "$ref": "https://leafseamer.invalid/design/df02-supervisor/supervisor.schema.json#/$defs/Id"
                  }
                },
                "required": [
                  "kind",
                  "close_ref",
                  "retired_completion_ref",
                  "writer_exit_id"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "recovery_digest": {
          "$ref": "https://leafseamer.invalid/design/df02-supervisor/supervisor.schema.json#/$defs/Digest"
        }
      },
      "required": [
        "format_version",
        "recovery_id",
        "revision",
        "binding",
        "snapshot_ref",
        "provider_ref",
        "selected_tick_ns",
        "targets",
        "recovery_digest"
      ],
      "additionalProperties": false
    }
  }
}
