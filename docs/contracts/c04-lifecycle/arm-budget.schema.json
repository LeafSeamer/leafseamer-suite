{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafseamer.invalid/design/c04-lifecycle/arm-budget.schema.json",
  "title": "arm-protection-budget/0.1.0-draft.1",
  "x-approved": false,
  "not": {},
  "$defs": {
    "Vector": {
      "type": "object",
      "properties": {
        "logical_rows": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
        },
        "logical_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
        },
        "queue_slots": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
        },
        "work_units": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
        }
      },
      "required": [
        "logical_rows",
        "logical_bytes",
        "queue_slots",
        "work_units"
      ],
      "additionalProperties": false
    },
    "Shape": {
      "type": "object",
      "properties": {
        "dependencies": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
        },
        "runs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
        },
        "executions": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
        },
        "preparations": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
        },
        "submissions": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
        },
        "controller_targets": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
        }
      },
      "required": [
        "dependencies",
        "runs",
        "executions",
        "preparations",
        "submissions",
        "controller_targets"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "authority_service_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "database_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        }
      },
      "required": [
        "authority_service_id",
        "database_instance_id"
      ],
      "additionalProperties": false
    },
    "Ref": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "object",
          "properties": {
            "authority_service_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
            },
            "database_instance_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
            }
          },
          "required": [
            "authority_service_id",
            "database_instance_id"
          ],
          "additionalProperties": false
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}(?![\\s\\S])"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "scope",
        "id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "Profile": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "arm-protection-budget/0.1.0-draft.1"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}(?![\\s\\S])"
        },
        "purpose": {
          "enum": [
            "simulation",
            "release_candidate"
          ]
        },
        "capacity": {
          "$ref": "#/$defs/Vector"
        },
        "max_shape": {
          "$ref": "#/$defs/Shape"
        },
        "max_row_bytes": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}(?![\\s\\S])"
        },
        "episodes": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}(?![\\s\\S])"
        },
        "max_queue_wait_ns": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}(?![\\s\\S])"
        },
        "validation_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contract_version",
        "profile_id",
        "revision",
        "purpose",
        "capacity",
        "max_shape",
        "max_row_bytes",
        "episodes",
        "max_queue_wait_ns",
        "validation_ref"
      ],
      "additionalProperties": false
    },
    "Binding": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "object",
          "properties": {
            "authority_service_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
            },
            "database_instance_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
            }
          },
          "required": [
            "authority_service_id",
            "database_instance_id"
          ],
          "additionalProperties": false
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}(?![\\s\\S])"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "inventory_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "profile_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}(?![\\s\\S])"
        },
        "profile_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "forecast": {
          "$ref": "#/$defs/Shape"
        }
      },
      "required": [
        "scope",
        "run_id",
        "generation",
        "operation_id",
        "artifact_digest",
        "inventory_digest",
        "profile_id",
        "profile_revision",
        "profile_digest",
        "forecast"
      ],
      "additionalProperties": false
    },
    "Reservation": {
      "type": "object",
      "properties": {
        "reservation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "binding_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "per_episode": {
          "$ref": "#/$defs/Vector"
        },
        "held": {
          "$ref": "#/$defs/Vector"
        },
        "spent": {
          "$ref": "#/$defs/Vector"
        },
        "episodes_left": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
        },
        "state": {
          "enum": [
            "held",
            "exhausted",
            "released"
          ]
        }
      },
      "required": [
        "reservation_id",
        "binding",
        "binding_digest",
        "per_episode",
        "held",
        "spent",
        "episodes_left",
        "state"
      ],
      "additionalProperties": false
    },
    "ProtectionUse": {
      "type": "object",
      "properties": {
        "reservation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "event_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "kind": {
          "enum": [
            "source",
            "preparation",
            "control",
            "authorization",
            "time",
            "storage"
          ]
        },
        "binding_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "observed_shape": {
          "$ref": "#/$defs/Shape"
        },
        "observed_max_row_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
        }
      },
      "required": [
        "reservation_id",
        "event_id",
        "event_digest",
        "kind",
        "binding_digest",
        "observed_shape",
        "observed_max_row_bytes"
      ],
      "additionalProperties": false
    },
    "ReleaseProof": {
      "type": "object",
      "properties": {
        "reservation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "binding_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "proof_ref": {
          "$ref": "#/$defs/Ref"
        },
        "generation_closed": {
          "const": true
        },
        "all_targets_accounted": {
          "const": true
        },
        "no_unresolved_references": {
          "const": true
        },
        "archive_durable": {
          "const": true
        }
      },
      "required": [
        "reservation_id",
        "binding_digest",
        "proof_ref",
        "generation_closed",
        "all_targets_accounted",
        "no_unresolved_references",
        "archive_durable"
      ],
      "additionalProperties": false
    }
  }
}
