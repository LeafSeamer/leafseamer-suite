        "authority_service_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "database_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        }
      },
      "required": [
        "authority_service_id",
        "database_instance_id"
      ],
      "additionalProperties": false
    },
    "Ref": {
      "type": "object",
