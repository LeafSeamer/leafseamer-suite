          "provider": "handle",
          "paths": [
            "preview_id",
            "preview_digest",
            "baseline"
          ],
          "rule": "固定原预览、失败集合与当前会话，不给面板原凭据"
        },
        "remaining_ms": {
          "kind": "provider",
          "provider": "deadline",
          "paths": [
            "clock",
            "issued_tick_ns",
            "expires_tick_ns"
          ],
          "rule": "同域截止，不把不透明tick转UTC"
        },
        "items": {
          "kind": "provider",
          "provider": "execution",
          "paths": [
            "plan"
          ],
          "rule": "完整保留step_id/disposition，previous command按可见性给ID或隐藏标记；每个evidence_ref和非空parameters_ref由精确原件构造批准Schema的QualifiedValue摘要，dynamic逐字段核权限；必要摘要隐藏则整份不可用，不删步骤或用空集替代读取失败"
        },
        "unresolved": {
          "kind": "provider",
          "provider": "visibility",
          "paths": [
            "unresolved_command_refs"
          ],
          "rule": "可见ID与has_hidden；有隐藏必要决策内容时整份确认预览不可用"
        }
      }
    },
    "RecoveryOperationView": {
      "source_model": "lifecycle__LifecycleOperation",
