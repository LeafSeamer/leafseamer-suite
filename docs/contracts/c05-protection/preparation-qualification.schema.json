{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafseamer.invalid/design/c05-protection/preparation-qualification.schema.json",
  "title": "preparation-qualification/0.1.0-draft.1",
  "x-approved": false,
  "not": {},
  "$defs": {
    "Binding": {
      "type": "object",
      "properties": {
        "controller_scope": {
          "type": "object",
          "properties": {
            "authority_service_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
            },
            "database_instance_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
            }
          },
          "required": [
            "authority_service_id",
            "database_instance_id"
          ],
          "additionalProperties": false
        },
        "origin_scope": {
          "type": "object",
          "properties": {
            "authority_service_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
            },
            "database_instance_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
            }
          },
          "required": [
            "authority_service_id",
            "database_instance_id"
          ],
          "additionalProperties": false
        },
        "preparation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
        },
        "generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$(?![\\s\\S])"
        },
        "mode": {
          "enum": [
            "arm",
            "recovery"
          ]
        },
        "execution_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "controller_scope",
        "origin_scope",
        "preparation_id",
        "run_id",
        "generation",
        "mode",
        "execution_id",
        "request_digest"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "arm"
              }
            }
          },
          "then": {
            "properties": {
              "execution_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "execution_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
              }
            }
          }
        }
      ]
    },
    "Withdrawal": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "preparation-qualification/0.1.0-draft.1"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "reason": {
          "enum": [
            "authorization_revoked",
            "grant_expired",
            "controller_instance_changed",
            "stream_unconfirmed"
          ]
        },
        "proof_ref": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "object",
              "properties": {
                "authority_service_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
                },
                "database_instance_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
                }
              },
              "required": [
                "authority_service_id",
                "database_instance_id"
              ],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
            },
            "revision": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$(?![\\s\\S])"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
            }
          },
          "required": [
            "scope",
            "id",
            "revision",
            "digest"
          ],
          "additionalProperties": false
        },
        "withdrawal_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "contract_version",
        "event_id",
        "binding",
        "reason",
        "proof_ref",
        "withdrawal_digest"
      ],
      "additionalProperties": false
    }
  }
}
