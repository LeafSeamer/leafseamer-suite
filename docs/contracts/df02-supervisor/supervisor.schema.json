        "version": {
          "const": "supervisor-control/0.1.0-draft.1"
        },
        "type": {
          "const": "FENCE_RESULT"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "channel_id": {
          "$ref": "#/$defs/Id"
        },
        "sequence": {
          "$ref": "#/$defs/U20"
        },
        "message_id": {
          "$ref": "#/$defs/Id"
        },
        "reply_to": {
          "$ref": "#/$defs/Id"
        },
        "payload": {
          "$ref": "#/$defs/FenceResult"
        }
      },
      "required": [
