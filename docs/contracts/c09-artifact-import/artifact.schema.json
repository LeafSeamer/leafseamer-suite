{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafseamer.invalid/design/c09-artifact-import/artifact.schema.json",
  "x-approved": false,
  "$defs": {
    "Id": {
      "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/Id"
    },
    "U20": {
      "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/U20"
    },
    "Digest": {
      "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/Digest"
    },
    "ClockRef": {
      "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/ClockRef"
    },
    "Permission": {
      "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/Permission"
    },
    "ArtifactIntakeReceipt": {
      "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/ArtifactIntakeReceipt"
    },
    "RoleDeclaration": {
      "type": "object",
      "properties": {
        "role_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "enum": [
            "device",
            "source",
            "data_object",
            "secret_role",
            "filesystem_role",
            "helper_artifact",
            "protocol_profile",
            "validation_policy",
            "run",
            "endpoint"
          ]
        },
        "minimum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "role_id",
        "kind",
        "minimum",
        "maximum",
        "purpose"
      ],
      "additionalProperties": false
    },
    "Binding_device": {
      "type": "object",
      "properties": {
        "role_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "device"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/DeviceRef"
          },
          "maxItems": 64,
          "minItems": 1,
          "uniqueItems": true
        },
        "configuration_ref": {
          "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/ConfigurationRef"
        }
      },
      "required": [
        "role_id",
        "kind",
        "values",
        "configuration_ref"
      ],
      "additionalProperties": false
    },
    "Binding_source": {
      "type": "object",
      "properties": {
        "role_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "source"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/SourceRef"
          },
          "maxItems": 64,
          "minItems": 1,
          "uniqueItems": true
        },
        "configuration_ref": {
          "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/ConfigurationRef"
        }
      },
      "required": [
        "role_id",
        "kind",
        "values",
        "configuration_ref"
      ],
      "additionalProperties": false
    },
    "Binding_data_object": {
      "type": "object",
      "properties": {
        "role_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "data_object"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/DataObjectRef"
          },
          "maxItems": 64,
          "minItems": 1,
          "uniqueItems": true
        },
        "configuration_ref": {
          "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/ConfigurationRef"
        }
      },
      "required": [
        "role_id",
        "kind",
        "values",
        "configuration_ref"
      ],
      "additionalProperties": false
    },
    "Binding_secret_role": {
      "type": "object",
      "properties": {
        "role_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "secret_role"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/SecretRoleRef"
          },
          "maxItems": 64,
          "minItems": 1,
          "uniqueItems": true
        },
        "configuration_ref": {
          "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/ConfigurationRef"
        }
      },
      "required": [
        "role_id",
        "kind",
        "values",
        "configuration_ref"
      ],
      "additionalProperties": false
    },
    "Binding_filesystem_role": {
      "type": "object",
      "properties": {
        "role_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "filesystem_role"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/FilesystemRoleRef"
          },
          "maxItems": 64,
          "minItems": 1,
          "uniqueItems": true
        },
        "configuration_ref": {
          "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/ConfigurationRef"
        }
      },
      "required": [
        "role_id",
        "kind",
        "values",
        "configuration_ref"
      ],
      "additionalProperties": false
    },
    "Binding_helper_artifact": {
      "type": "object",
      "properties": {
        "role_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "helper_artifact"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/HelperArtifactRef"
          },
          "maxItems": 64,
          "minItems": 1,
          "uniqueItems": true
        },
        "configuration_ref": {
          "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/ConfigurationRef"
        }
      },
      "required": [
        "role_id",
        "kind",
        "values",
        "configuration_ref"
      ],
      "additionalProperties": false
    },
    "Binding_protocol_profile": {
      "type": "object",
      "properties": {
        "role_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "protocol_profile"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/ProtocolProfileRef"
          },
          "maxItems": 64,
          "minItems": 1,
          "uniqueItems": true
        },
        "configuration_ref": {
          "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/ConfigurationRef"
        }
      },
      "required": [
        "role_id",
        "kind",
        "values",
        "configuration_ref"
      ],
      "additionalProperties": false
    },
    "Binding_validation_policy": {
      "type": "object",
      "properties": {
        "role_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "validation_policy"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/ValidationPolicyRef"
          },
          "maxItems": 64,
          "minItems": 1,
          "uniqueItems": true
        },
        "configuration_ref": {
          "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/ConfigurationRef"
        }
      },
      "required": [
        "role_id",
        "kind",
        "values",
        "configuration_ref"
      ],
      "additionalProperties": false
    },
    "Binding_run": {
      "type": "object",
      "properties": {
        "role_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "run"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/RunRef"
          },
          "maxItems": 64,
          "minItems": 1,
          "uniqueItems": true
        },
        "configuration_ref": {
          "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/ConfigurationRef"
        }
      },
      "required": [
        "role_id",
        "kind",
        "values",
        "configuration_ref"
      ],
      "additionalProperties": false
    },
    "Binding_endpoint": {
      "type": "object",
      "properties": {
        "role_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "endpoint"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "required": [
              "host",
              "port"
            ],
            "additionalProperties": false
          },
          "maxItems": 1,
          "minItems": 1,
          "uniqueItems": true
        },
        "configuration_ref": {
          "$ref": "https://leafseamer.invalid/design/c09-installation/installation.schema.json#/$defs/ConfigurationRef"
        }
      },
      "required": [
        "role_id",
        "kind",
        "values",
        "configuration_ref"
      ],
      "additionalProperties": false
    },
    "RoleBinding": {
      "oneOf": [
        {
          "$ref": "#/$defs/Binding_device"
        },
        {
          "$ref": "#/$defs/Binding_source"
        },
        {
          "$ref": "#/$defs/Binding_data_object"
        },
        {
          "$ref": "#/$defs/Binding_secret_role"
        },
        {
          "$ref": "#/$defs/Binding_filesystem_role"
        },
        {
          "$ref": "#/$defs/Binding_helper_artifact"
        },
        {
          "$ref": "#/$defs/Binding_protocol_profile"
        },
        {
          "$ref": "#/$defs/Binding_validation_policy"
        },
        {
          "$ref": "#/$defs/Binding_run"
        },
        {
          "$ref": "#/$defs/Binding_endpoint"
        }
      ]
    },
    "Template_device_scope": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "device_scope"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scope": {
          "type": "object",
          "properties": {
            "device_role": {
              "$ref": "#/$defs/Id"
            },
            "action_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Id"
              },
              "maxItems": 128,
              "minItems": 0,
              "uniqueItems": true
            },
            "trigger_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Id"
              },
              "maxItems": 128,
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "device_role",
            "action_ids",
            "trigger_ids"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "kind",
        "purpose",
        "scope"
      ],
      "additionalProperties": false
    },
    "Template_data_scope": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "data_scope"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scope": {
          "type": "object",
          "properties": {
            "data_role": {
              "$ref": "#/$defs/Id"
            },
            "access": {
              "enum": [
                "read",
                "propose"
              ]
            }
          },
          "required": [
            "data_role",
            "access"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "kind",
        "purpose",
        "scope"
      ],
      "additionalProperties": false
    },
    "Template_network_endpoint": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "network_endpoint"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scope": {
          "type": "object",
          "properties": {
            "endpoint_role": {
              "$ref": "#/$defs/Id"
            },
            "protocol_profile_role": {
              "$ref": "#/$defs/Id"
            },
            "transport": {
              "enum": [
                "tcp",
                "udp",
                "https",
                "wss"
              ]
            },
            "min_port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "max_port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": [
            "endpoint_role",
            "protocol_profile_role",
            "transport",
            "min_port",
            "max_port"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "kind",
        "purpose",
        "scope"
      ],
      "additionalProperties": false
    },
    "Template_secret_role": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "secret_role"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scope": {
          "type": "object",
          "properties": {
            "secret_role": {
              "$ref": "#/$defs/Id"
            },
            "device_role": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_role": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Id"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "secret_role",
            "device_role",
            "source_role"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "kind",
        "purpose",
        "scope"
      ],
      "additionalProperties": false
    },
    "Template_filesystem_root_role": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "filesystem_root_role"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scope": {
          "type": "object",
          "properties": {
            "filesystem_role": {
              "$ref": "#/$defs/Id"
            },
            "access": {
              "enum": [
                "read",
                "cache_write"
              ]
            },
            "quota_bytes": {
              "$ref": "#/$defs/U20"
            }
          },
          "required": [
            "filesystem_role",
            "access",
            "quota_bytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "kind",
        "purpose",
        "scope"
      ],
      "additionalProperties": false
    },
    "Template_helper_artifact": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "helper_artifact"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scope": {
          "type": "object",
          "properties": {
            "helper_role": {
              "$ref": "#/$defs/Id"
            },
            "launch_policy_role": {
              "$ref": "#/$defs/Id"
            },
            "helper_file_id": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "helper_role",
            "launch_policy_role",
            "helper_file_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "kind",
        "purpose",
        "scope"
      ],
      "additionalProperties": false
    },
    "Template_panel_method": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "panel_method"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scope": {
          "type": "object",
          "properties": {
            "authority": {
              "enum": [
                "controller",
                "seamer"
              ]
            },
            "method_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Id"
              },
              "maxItems": 35,
              "minItems": 1,
              "uniqueItems": true
            },
            "object_roles": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Id"
              },
              "maxItems": 128,
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "authority",
            "method_ids",
            "object_roles"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "kind",
        "purpose",
        "scope"
      ],
      "additionalProperties": false
    },
    "Template_protocol_io": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "protocol_io"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scope": {
          "type": "object",
          "properties": {
            "protocol_profile_role": {
              "$ref": "#/$defs/Id"
            },
            "endpoint_request_id": {
              "$ref": "#/$defs/Id"
            },
            "frame_classes": {
              "type": "array",
              "items": {
                "enum": [
                  "authentication",
                  "query",
                  "subscription",
                  "keepalive",
                  "ack",
                  "control"
                ]
              },
              "maxItems": 6,
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "protocol_profile_role",
            "endpoint_request_id",
            "frame_classes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "kind",
        "purpose",
        "scope"
      ],
      "additionalProperties": false
    },
    "PermissionTemplate": {
      "oneOf": [
        {
          "$ref": "#/$defs/Template_device_scope"
        },
        {
          "$ref": "#/$defs/Template_data_scope"
        },
        {
          "$ref": "#/$defs/Template_network_endpoint"
        },
        {
          "$ref": "#/$defs/Template_secret_role"
        },
        {
          "$ref": "#/$defs/Template_filesystem_root_role"
        },
        {
          "$ref": "#/$defs/Template_helper_artifact"
        },
        {
          "$ref": "#/$defs/Template_panel_method"
        },
        {
          "$ref": "#/$defs/Template_protocol_io"
        }
      ]
    },
    "FileEntry": {
      "type": "object",
      "properties": {
        "file_id": {
          "$ref": "#/$defs/Id"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "size_bytes": {
          "$ref": "#/$defs/U20"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "role": {
          "enum": [
            "module",
            "native_helper",
            "panel",
            "schema",
            "license",
            "dependency_lock",
            "resource",
            "policy"
          ]
        },
        "executable": {
          "type": "boolean"
        }
      },
      "required": [
        "file_id",
        "path",
        "size_bytes",
        "digest",
        "role",
        "executable"
      ],
      "additionalProperties": false
    },
    "FileInventory": {
      "type": "object",
      "properties": {
        "inventory_version": {
          "const": "extension-files/1"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileEntry"
          },
          "maxItems": 65536,
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "inventory_version",
        "files"
      ],
      "additionalProperties": false
    },
    "Entrypoint": {
      "type": "object",
      "properties": {
        "entry_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "enum": [
            "worker",
            "panel",
            "helper"
          ]
        },
        "file_id": {
          "$ref": "#/$defs/Id"
        },
        "loader": {
          "enum": [
            "node_module",
            "native_binary",
            "static_document"
          ]
        },
        "io_policy_file_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "entry_id",
        "kind",
        "file_id",
        "loader",
        "io_policy_file_id"
      ],
      "additionalProperties": false
    },
    "Manifest": {
      "type": "object",
      "properties": {
        "manifest_version": {
          "const": "extension-artifact/0.1.0-draft.1"
        },
        "extension_id": {
          "$ref": "#/$defs/Id"
        },
        "extension_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "enum": [
            "device_module",
            "data_source",
            "panel",
            "nodecg_bridge"
          ]
        },
        "publisher_id": {
          "$ref": "#/$defs/Id"
        },
        "source_revision": {
          "$ref": "#/$defs/Id"
        },
        "inventory_digest": {
          "$ref": "#/$defs/Digest"
        },
        "dependency_lock_file_id": {
          "$ref": "#/$defs/Id"
        },
        "license_file_ids": {
          "type": "array",
          "items": {
