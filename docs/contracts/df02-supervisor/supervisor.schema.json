        },
        "message_id": {
          "$ref": "#/$defs/Id"
        },
        "reply_to": {
          "type": "null"
        },
        "payload": {
          "$ref": "#/$defs/Create"
        }
      },
      "required": [
        "version",
        "type",
        "scope",
        "channel_id",
        "sequence",
        "message_id",
        "reply_to",
        "payload"
      ],
      "additionalProperties": false
    },
    "LAUNCH_QUERY": {
      "type": "object",
      "properties": {
        "version": {
          "const": "supervisor-control/0.1.0-draft.1"
        },
        "type": {
