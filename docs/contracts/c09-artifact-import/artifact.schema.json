        "expected_manifest_digest",
        "host_trust_epoch",
        "release_authorization_ref",
        "validation_policy_ref"
      ],
      "additionalProperties": false
    },
    "ImportStatus": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/ImportIdentity"
        },
        "intent_digest": {
          "$ref": "#/$defs/Digest"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "state": {
          "enum": [
            "accepted",
            "copying",
            "validating",
            "sealing",
            "sealed",
            "cancelled",
            "rejected",
            "indeterminate"
          ]
        },
        "target_authority_service_id": {
          "$ref": "#/$defs/Id"
        },
        "package_digest": {
          "$ref": "#/$defs/Digest"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactIntakeReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "operator_cancelled",
                "content_mismatch",
                "invalid_archive",
                "trust_denied",
                "capacity",
                "storage_unknown",
                "source_unavailable"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "identity",
        "intent_digest",
        "operation_id",
        "state",
        "target_authority_service_id",
        "package_digest",
        "receipt",
        "reason_code"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "sealed"
              }
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "$ref": "#/$defs/ArtifactIntakeReceipt"
              },
              "reason_code": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "receipt": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "accepted",
                  "copying",
                  "validating",
                  "sealing"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "reason_code": {
                "const": "operator_cancelled"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "indeterminate"
              }
            }
          },
          "then": {
            "properties": {
              "reason_code": {
                "const": "storage_unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "rejected"
              }
            }
          },
          "then": {
            "properties": {
              "reason_code": {
                "enum": [
                  "content_mismatch",
                  "invalid_archive",
                  "trust_denied",
                  "capacity",
                  "source_unavailable"
                ]
              }
            }
          }
        }
      ]
    },
    "IntakeQuery": {
      "type": "object",
