{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafseamer.invalid/design/c02-admission/admission.schema.json",
  "title": "command-admission/0.1.0-draft.1",
  "not": {},
  "x-approved": false,
  "$defs": {
    "Id": {
      "$ref": "https://leafseamer.invalid/design/c05-protection/protocol.schema.json#/$defs/Id"
    },
    "Scope": {
      "$ref": "https://leafseamer.invalid/design/c05-protection/protocol.schema.json#/$defs/Scope"
    },
    "Digest": {
      "$ref": "https://leafseamer.invalid/design/c05-protection/protocol.schema.json#/$defs/Digest"
    },
    "Counter": {
      "$ref": "https://leafseamer.invalid/design/c05-protection/protocol.schema.json#/$defs/Counter"
    },
    "CommandRequest": {
      "$ref": "https://leafseamer.invalid/design/c05-protection/protocol.schema.json#/$defs/CommandRequest"
    },
    "CommandContent": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "https://leafseamer.invalid/contracts/draft4/first-loop.schema.json#/$defs/Id"
        },
        "action_id": {
          "$ref": "https://leafseamer.invalid/contracts/draft4/first-loop.schema.json#/$defs/Id"
        },
        "capability_version": {
          "$ref": "https://leafseamer.invalid/contracts/draft4/first-loop.schema.json#/$defs/Version"
        },
        "parameters": {
          "$ref": "https://leafseamer.invalid/contracts/draft4/first-loop.schema.json#/$defs/Payload"
        },
        "expected_control": {
          "$ref": "https://leafseamer.invalid/contracts/draft4/first-loop.schema.json#/$defs/ControlVersion"
        },
        "origin": {
          "enum": [
            "manual",
            "automation"
          ]
        },
        "run_binding": {
          "$ref": "https://leafseamer.invalid/design/c05-protection/protocol.schema.json#/$defs/RunBinding"
        },
        "required_completion": {
          "$ref": "https://leafseamer.invalid/contracts/draft4/first-loop.schema.json#/$defs/CompletionLevel"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "https://leafseamer.invalid/contracts/draft4/first-loop.schema.json#/$defs/Predicate"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "dispatch": {
          "$ref": "https://leafseamer.invalid/contracts/draft4/first-loop.schema.json#/$defs/Dispatch"
        },
        "evidence_timeout_ms": {
          "$ref": "https://leafseamer.invalid/contracts/draft4/first-loop.schema.json#/$defs/Duration"
        },
        "automation_binding": {
          "anyOf": [
            {
              "$ref": "https://leafseamer.invalid/design/c05-protection/protocol.schema.json#/$defs/AutomationOriginBinding"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "device_id",
        "action_id",
        "capability_version",
        "parameters",
        "expected_control",
        "origin",
        "required_completion",
        "preconditions",
        "dispatch",
        "evidence_timeout_ms",
        "automation_binding"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "automation"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "required": [
              "run_binding"
            ]
          },
          "else": {
            "not": {
              "required": [
                "run_binding"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action_id": {
                "const": "obs.program_scene.set"
              }
            },
            "required": [
              "action_id"
            ]
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "https://leafseamer.invalid/contracts/draft4/first-loop.schema.json#/$defs/ObsSceneParameters"
              },
              "required_completion": {
                "const": "effect_verified"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "automation"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "properties": {
              "automation_binding": {
                "$ref": "https://leafseamer.invalid/design/c05-protection/protocol.schema.json#/$defs/AutomationOriginBinding"
              }
            }
          },
          "else": {
            "properties": {
              "automation_binding": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "RequestKey": {
      "type": "object",
      "properties": {
        "target_scope": {
          "$ref": "#/$defs/Scope"
        },
        "issuer_id": {
          "$ref": "#/$defs/Id"
        },
        "issuer_epoch": {
          "$ref": "#/$defs/Id"
        },
        "principal_id": {
          "$ref": "#/$defs/Id"
        },
        "request_epoch": {
          "$ref": "#/$defs/Id"
        },
        "operation_id": {
          "const": "createCommand"
        },
        "idempotency_key": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "target_scope",
        "issuer_id",
        "issuer_epoch",
        "principal_id",
        "request_epoch",
        "operation_id",
        "idempotency_key"
      ],
      "additionalProperties": false
    },
    "RequestIdentity": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/RequestKey"
        },
        "request_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "key",
        "request_digest"
      ],
      "additionalProperties": false
    },
    "CommandRef": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "command"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "kind",
        "scope",
        "object_id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "CommitRef": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "controller_commit"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "kind",
        "scope",
        "object_id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "RequestAdjudication": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "command-admission/0.1.0-draft.1"
        },
        "adjudication_id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "const": "1"
        },
        "identity": {
          "$ref": "#/$defs/RequestIdentity"
        },
        "decision": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "command_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_ref": {
          "$ref": "#/$defs/CommitRef"
        },
        "adjudication_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "contract_version",
        "adjudication_id",
        "revision",
        "identity",
        "decision",
        "command_ref",
        "commit_ref",
        "adjudication_digest"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "accepted"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "command_ref": {
                "$ref": "#/$defs/CommandRef"
              }
            }
          },
          "else": {
            "properties": {
              "command_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "LookupResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "found"
            },
            "adjudication": {
              "$ref": "#/$defs/RequestAdjudication"
            }
          },
          "required": [
            "state",
            "adjudication"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "not_found",
                "indeterminate"
              ]
            },
            "adjudication": {
              "type": "null"
            }
          },
          "required": [
            "state",
            "adjudication"
          ],
          "additionalProperties": false
        }
      ]
    },
    "RejectRequest": {
      "type": "object",
      "properties": {
        "rejection_operation_id": {
          "$ref": "#/$defs/Id"
        },
        "identity": {
          "$ref": "#/$defs/RequestIdentity"
        },
        "content": {
          "$ref": "#/$defs/CommandContent"
        }
      },
      "required": [
        "rejection_operation_id",
        "identity",
        "content"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid",
            "unauthenticated",
            "forbidden",
            "conflict",
            "capacity",
            "unavailable",
            "version"
          ]
        },
        "request_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "code",
        "request_id"
      ],
      "additionalProperties": false
    }
  }
}
