        },
        "successor_resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[a-zA-Z0-9_.:-]+(/[a-zA-Z0-9_.:-]+)*$"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "graph_complete": {
          "type": "boolean"
        },
        "control_dependency": {
          "type": "boolean"
        },
        "verdict": {
          "enum": [
            "independent",
            "dependent",
            "unknown"
          ]
        }
      },
      "required": [
        "proof_id",
        "proof_revision",
        "generator_version",
        "definition_digest",
        "bindings_digest",
        "failed_step_id",
        "successor_step_ids",
        "failed_footprint",
        "successor_reads",
        "successor_writes",
        "successor_resources",
        "graph_complete",
        "control_dependency",
        "verdict"
