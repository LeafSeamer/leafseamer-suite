        },
        "channel_id": {
          "$ref": "#/$defs/Id"
        },
        "sequence": {
          "$ref": "#/$defs/U20"
        },
        "message_id": {
          "$ref": "#/$defs/Id"
        },
        "reply_to": {
          "type": "null"
        },
        "payload": {
          "$ref": "#/$defs/LaunchKey"
        }
      },
      "required": [
        "version",
        "type",
        "scope",
        "channel_id",
        "sequence",
        "message_id",
        "reply_to",
        "payload"
      ],
      "additionalProperties": false
    },
    "RETIRE_REQUEST": {
      "type": "object",
      "properties": {
        "version": {
          "const": "supervisor-control/0.1.0-draft.1"
        },
        "type": {
          "const": "RETIRE_REQUEST"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "channel_id": {
          "$ref": "#/$defs/Id"
        },
        "sequence": {
          "$ref": "#/$defs/U20"
        },
        "message_id": {
          "$ref": "#/$defs/Id"
        },
        "reply_to": {
          "type": "null"
        },
        "payload": {
          "$ref": "#/$defs/RetireRequest"
        }
      },
      "required": [
