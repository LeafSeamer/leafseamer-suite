        "action_ref",
        "manifest_digest",
        "semantics_revision",
        "complete",
        "reads",
        "writes",
        "failure_writes",
        "resources",
        "safe_failure_classes"
      ],
      "additionalProperties": false
    },
    "IndependenceProof": {
      "type": "object",
      "properties": {
        "proof_id": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "proof_revision": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Revision"
        },
        "generator_version": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "definition_digest": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Digest"
        },
        "bindings_digest": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Digest"
