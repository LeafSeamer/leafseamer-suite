    "ExecutionIdentity": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "ordinary",
            "cancel"
          ]
        },
        "command_ref": {
          "$ref": "#/$defs/Ref"
        },
        "attempt_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
