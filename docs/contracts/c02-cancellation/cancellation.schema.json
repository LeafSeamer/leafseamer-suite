{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafseamer.invalid/design/c02-cancellation/cancellation.schema.json",
  "title": "command-cancellation/0.1.0-draft.1",
  "x-approved": false,
  "x-runtime-approved": false,
  "not": {},
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$(?![\\s\\S])"
    },
    "PositiveCounter": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$(?![\\s\\S])"
    },
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "SendWindow": {
      "$ref": "https://leafseamer.invalid/design/c08-controller/execution-ipc.schema.json#/$defs/SendWindow"
    },
    "TransmissionRef": {
      "$ref": "https://leafseamer.invalid/design/c08-controller/execution-ipc.schema.json#/$defs/TransmissionRef"
    },
    "TransmissionCoverage": {
      "$ref": "https://leafseamer.invalid/design/c08-controller/execution-ipc.schema.json#/$defs/TransmissionCoverage"
    },
    "BarrierAttemptBinding": {
      "$ref": "https://leafseamer.invalid/design/c08-controller/execution-ipc.schema.json#/$defs/BarrierAttemptBinding"
    },
    "ContentRef": {
      "$ref": "https://leafseamer.invalid/design/c08-controller/execution-ipc.schema.json#/$defs/ContentRef"
    },
    "PacketRef": {
      "$ref": "https://leafseamer.invalid/design/c08-controller/execution-ipc.schema.json#/$defs/PacketRef"
    },
    "Ref": {
      "$ref": "https://leafseamer.invalid/design/c08-controller/lifecycle.schema.json#/$defs/Ref"
    },
    "Scope": {
      "$ref": "https://leafseamer.invalid/design/c08-controller/lifecycle.schema.json#/$defs/Scope"
    },
    "CancelIdentity": {
      "$ref": "https://leafseamer.invalid/design/c02-command-view/command.schema.json#/$defs/CancelIdentity"
    },
    "Exit": {
      "type": "object",
      "properties": {
        "writer_exit_id": {
          "$ref": "#/$defs/Id"
        },
        "controller_boot_id": {
          "$ref": "#/$defs/Id"
        },
        "worker_boot_id": {
          "$ref": "#/$defs/Id"
        },
        "ipc_session_id": {
          "$ref": "#/$defs/Id"
        },
        "device_id": {
          "$ref": "#/$defs/Id"
        },
        "device_session_id": {
          "$ref": "#/$defs/Id"
        },
        "socket_instance_id": {
          "$ref": "#/$defs/Id"
        },
        "clock_domain_id": {
          "type": "string",
          "pattern": "^clock_[0-9a-f]{64}$(?![\\s\\S])"
        },
        "descriptor_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "writer_exit_id",
        "controller_boot_id",
        "worker_boot_id",
        "ipc_session_id",
        "device_id",
        "device_session_id",
        "socket_instance_id",
        "clock_domain_id",
        "descriptor_digest"
      ],
      "additionalProperties": false
    },
    "CancellationBinding": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "cancellation_id": {
          "$ref": "#/$defs/Id"
        },
        "parent_command_id": {
          "$ref": "#/$defs/Id"
        },
        "initial_operation_ref": {
          "$ref": "#/$defs/Ref"
        },
        "identity": {
          "$ref": "#/$defs/CancelIdentity"
        },
        "mode": {
          "enum": [
            "before_dispatch_only",
            "cooperative"
          ]
        },
        "policy_ref": {
          "$ref": "#/$defs/Ref"
        }
      },
      "required": [
        "scope",
        "cancellation_id",
        "parent_command_id",
        "initial_operation_ref",
        "identity",
        "mode",
        "policy_ref"
      ],
      "additionalProperties": false
    },
    "DenyEntry": {
      "type": "object",
      "properties": {
        "cancellation_id": {
          "$ref": "#/$defs/Id"
        },
        "parent_command_id": {
          "$ref": "#/$defs/Id"
        },
        "stage": {
          "enum": [
            "ordinary",
            "all"
          ]
        },
        "deny_revision": {
          "$ref": "#/$defs/PositiveCounter"
        },
        "cut_ref": {
          "$ref": "#/$defs/Ref"
        }
      },
      "required": [
        "cancellation_id",
        "parent_command_id",
        "stage",
        "deny_revision",
        "cut_ref"
      ],
      "additionalProperties": false
    },
    "DenySnapshot": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "device_id": {
          "$ref": "#/$defs/Id"
        },
        "snapshot_revision": {
          "$ref": "#/$defs/Counter"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DenyEntry"
          },
          "maxItems": 4096
        },
        "snapshot_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "scope",
        "device_id",
        "snapshot_revision",
        "entries",
        "snapshot_digest"
      ],
      "additionalProperties": false
    },
    "Requester": {
      "type": "object",
      "properties": {
        "actor_ref": {
          "$ref": "#/$defs/Ref"
        },
        "authorization_ref": {
          "$ref": "#/$defs/Ref"
        },
        "origin": {
          "enum": [
            "manual",
            "automation"
          ]
        },
        "admission_origin": {
          "enum": [
            "panel",
            "non_panel"
          ]
        },
        "panel_binding_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "automation_binding_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "actor_ref",
        "authorization_ref",
        "origin",
        "admission_origin",
        "panel_binding_ref",
        "automation_binding_ref"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "automation"
              }
            }
          },
          "then": {
            "properties": {
              "automation_binding_ref": {
                "$ref": "#/$defs/Ref"
              },
              "admission_origin": {
                "const": "non_panel"
              }
            }
          },
          "else": {
            "properties": {
              "automation_binding_ref": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "admission_origin": {
                "const": "panel"
              }
            }
          },
          "then": {
            "properties": {
              "panel_binding_ref": {
                "$ref": "#/$defs/Ref"
              },
              "origin": {
                "const": "manual"
              }
            }
          },
          "else": {
            "properties": {
              "panel_binding_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Policy": {
      "type": "object",
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/PositiveCounter"
        },
        "mode": {
          "enum": [
            "before_dispatch_only",
            "cooperative"
          ]
        },
        "procedure_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "completion_policy_ref": {
          "$ref": "#/$defs/Ref"
        },
        "release_policy_ref": {
          "$ref": "#/$defs/Ref"
        },
        "resource_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 256,
          "minItems": 1,
          "uniqueItems": true
        },
        "max_transmissions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "allow_protocol_resend": {
          "type": "boolean"
        },
        "application_attempts": {
          "const": 1
        },
        "policy_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "policy_id",
        "revision",
        "mode",
        "procedure_ref",
        "completion_policy_ref",
        "release_policy_ref",
        "resource_keys",
        "max_transmissions",
        "allow_protocol_resend",
        "application_attempts",
        "policy_digest"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "cooperative"
              }
            }
          },
          "then": {
            "properties": {
              "procedure_ref": {
                "$ref": "#/$defs/Ref"
              }
            }
          },
          "else": {
            "properties": {
              "procedure_ref": {
                "type": "null"
              },
              "allow_protocol_resend": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "Primitive": {
      "type": "object",
      "properties": {
        "primitive_id": {
          "$ref": "#/$defs/Id"
        },
        "action_ref": {
          "$ref": "#/$defs/Ref"
        },
        "parameters_schema_ref": {
          "$ref": "#/$defs/Ref"
        },
        "parameters": {
          "type": "object"
        },
        "after": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 256
        },
        "completion_policy_ref": {
          "$ref": "#/$defs/Ref"
        }
      },
      "required": [
        "primitive_id",
        "action_ref",
        "parameters_schema_ref",
        "parameters",
        "after",
        "completion_policy_ref"
      ],
      "additionalProperties": false
    },
    "ExecutionPlan": {
      "type": "object",
      "properties": {
        "execution_id": {
          "$ref": "#/$defs/Id"
        },
        "binding": {
          "allOf": [
            {
              "$ref": "#/$defs/CancellationBinding"
            },
            {
              "properties": {
                "mode": {
                  "const": "cooperative"
                }
              }
            }
          ]
        },
        "requester": {
          "$ref": "#/$defs/Requester"
        },
        "device_id": {
          "$ref": "#/$defs/Id"
        },
        "ordinary_closure_ref": {
          "$ref": "#/$defs/Ref"
        },
        "policy_ref": {
          "$ref": "#/$defs/Ref"
        },
        "protected_hold_ref": {
          "$ref": "#/$defs/Ref"
        },
        "resource_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 256,
          "minItems": 1,
          "uniqueItems": true
        },
        "primitives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Primitive"
          },
          "maxItems": 256,
          "minItems": 1
        },
        "execution_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "execution_id",
        "binding",
        "requester",
        "device_id",
        "ordinary_closure_ref",
        "policy_ref",
        "protected_hold_ref",
        "resource_keys",
        "primitives",
        "execution_digest"
      ],
      "additionalProperties": false
    },
    "Guard": {
      "type": "object",
      "properties": {
        "guard_id": {
          "$ref": "#/$defs/Id"
        },
        "execution_ref": {
          "$ref": "#/$defs/Ref"
        },
        "requester": {
          "$ref": "#/$defs/Requester"
        },
        "exit": {
          "$ref": "#/$defs/Exit"
        },
        "control_epoch": {
          "$ref": "#/$defs/Id"
        },
        "control_version": {
          "$ref": "#/$defs/PositiveCounter"
        },
        "gate_revision": {
          "$ref": "#/$defs/PositiveCounter"
        },
        "authorization_revision": {
          "$ref": "#/$defs/PositiveCounter"
        },
        "time_required": {
          "type": "boolean"
        },
        "time_evidence_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_policy_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "guard_provider_ref": {
          "$ref": "#/$defs/Ref"
        },
        "protected_hold_ref": {
          "$ref": "#/$defs/Ref"
        },
        "deny_revision": {
          "$ref": "#/$defs/PositiveCounter"
        },
        "send_window": {
          "$ref": "#/$defs/SendWindow"
        },
        "guard_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "guard_id",
        "execution_ref",
        "requester",
        "exit",
        "control_epoch",
        "control_version",
        "gate_revision",
        "authorization_revision",
        "time_required",
        "time_evidence_ref",
        "time_policy_ref",
        "guard_provider_ref",
        "protected_hold_ref",
        "deny_revision",
        "send_window",
        "guard_digest"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "time_required": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "time_evidence_ref": {
                "$ref": "#/$defs/Ref"
              },
              "time_policy_ref": {
                "$ref": "#/$defs/Ref"
              }
            }
          },
          "else": {
            "properties": {
              "time_evidence_ref": {
                "type": "null"
              },
              "time_policy_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Packet": {
      "type": "object",
      "properties": {
        "packet_id": {
          "$ref": "#/$defs/Id"
        },
        "execution_ref": {
          "$ref": "#/$defs/Ref"
        },
        "cancellation_id": {
          "$ref": "#/$defs/Id"
        },
        "parent_command_id": {
          "$ref": "#/$defs/Id"
        },
        "primitive_id": {
          "$ref": "#/$defs/Id"
        },
        "exit": {
          "$ref": "#/$defs/Exit"
        },
        "protocol_session": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "wire_packet_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "tracking_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 256
        },
        "immutable_bytes_ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "transport_profile_ref": {
          "$ref": "#/$defs/Ref"
        },
        "packet_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "packet_id",
        "execution_ref",
        "cancellation_id",
        "parent_command_id",
        "primitive_id",
        "exit",
        "protocol_session",
        "wire_packet_id",
        "tracking_ids",
        "immutable_bytes_ref",
        "byte_length",
        "sha256",
        "transport_profile_ref",
        "packet_digest"
      ],
      "additionalProperties": false
    },
    "Transmission": {
      "type": "object",
      "properties": {
        "permit_id": {
          "$ref": "#/$defs/Id"
        },
        "transmission_id": {
          "$ref": "#/$defs/Id"
        },
        "execution_ref": {
          "$ref": "#/$defs/Ref"
        },
        "cancellation_id": {
          "$ref": "#/$defs/Id"
        },
        "parent_command_id": {
          "$ref": "#/$defs/Id"
        },
        "primitive_id": {
          "$ref": "#/$defs/Id"
        },
        "packet_ref": {
          "$ref": "#/$defs/PacketRef"
        },
        "exit": {
          "$ref": "#/$defs/Exit"
        },
        "requester": {
          "$ref": "#/$defs/Requester"
        },
        "guard_ref": {
          "$ref": "#/$defs/Ref"
        },
        "ordinal": {
          "$ref": "#/$defs/Counter"
        },
        "initial_permit_id": {
          "$ref": "#/$defs/Id"
        },
        "issued_revision": {
          "$ref": "#/$defs/PositiveCounter"
        },
        "kind": {
          "enum": [
            "initial",
            "protocol_resend"
          ]
        },
        "trigger_observation_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "budget_receipt_ref": {
          "$ref": "#/$defs/Ref"
        },
        "send_window": {
          "$ref": "#/$defs/SendWindow"
        }
      },
      "required": [
        "permit_id",
        "transmission_id",
        "execution_ref",
        "cancellation_id",
        "parent_command_id",
        "primitive_id",
        "packet_ref",
        "exit",
        "requester",
        "guard_ref",
        "ordinal",
        "initial_permit_id",
        "issued_revision",
        "kind",
        "trigger_observation_ref",
        "budget_receipt_ref",
        "send_window"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "initial"
              }
            }
          },
          "then": {
            "properties": {
              "ordinal": {
                "const": "0"
              },
              "trigger_observation_ref": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "ordinal": {
                "$ref": "#/$defs/PositiveCounter"
              },
              "trigger_observation_ref": {
                "$ref": "#/$defs/Ref"
              }
            }
          }
        }
      ]
    },
    "CancelCoverage": {
      "type": "object",
      "properties": {
        "intent": {
          "$ref": "#/$defs/Transmission"
        },
        "disposition": {
          "enum": [
            "not_sent",
            "in_flight",
            "unknown"
          ]
        },
        "proof": {
          "enum": [
            "never_received",
            "discarded_unconsumed",
            "transport_entered",
            "send_uncertain"
          ]
        }
      },
      "required": [
        "intent",
        "disposition",
        "proof"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "not_sent"
              }
            }
          },
          "then": {
            "properties": {
              "proof": {
                "enum": [
                  "never_received",
                  "discarded_unconsumed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "in_flight"
              }
            }
          },
          "then": {
            "properties": {
              "proof": {
                "enum": [
                  "transport_entered"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "proof": {
                "enum": [
                  "send_uncertain"
                ]
              }
            }
          }
        }
      ]
    },
    "CutTarget": {
      "type": "object",
      "properties": {
        "exit": {
          "$ref": "#/$defs/Exit"
        },
        "ordinary_attempt_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 256
        },
        "ordinary_transmissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TransmissionRef"
          },
          "maxItems": 256
        },
        "cancel_prepare_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 256
        },
        "cancel_transmissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Transmission"
          },
          "maxItems": 256
        },
        "target_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "exit",
        "ordinary_attempt_ids",
        "ordinary_transmissions",
        "cancel_prepare_ids",
        "cancel_transmissions",
        "target_digest"
      ],
      "additionalProperties": false
    },
    "Cut": {
      "type": "object",
      "properties": {
        "cut_id": {
          "$ref": "#/$defs/Id"
        },
        "binding": {
          "$ref": "#/$defs/CancellationBinding"
        },
        "stage": {
          "enum": [
            "ordinary",
            "all"
          ]
        },
        "previous_cut_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "issued_revision": {
          "$ref": "#/$defs/Counter"
        },
        "deny_revision": {
          "$ref": "#/$defs/PositiveCounter"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CutTarget"
          },
          "maxItems": 256
        },
        "cut_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "cut_id",
        "binding",
        "stage",
        "previous_cut_ref",
        "issued_revision",
        "deny_revision",
        "targets",
        "cut_digest"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
