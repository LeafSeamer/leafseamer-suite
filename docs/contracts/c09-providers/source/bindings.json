        }
      }
    },
    "PublishedDefinitionView": {
      "source_model": "lifecycle__PublishedVersion",
      "relation": "固定发布与artifact、program、bindings全链；源草稿修订独立于definition_version",
      "fields": {
        "definition_id": {
          "kind": "source",
          "path": "definition_id"
        },
        "definition_version": {
          "kind": "source",
          "path": "definition_version"
        },
        "source_draft_revision": {
          "kind": "source",
          "path": "source_draft_revision"
        },
        "artifact_ref": {
          "kind": "source",
          "path": "artifact_ref"
        },
        "program_digest": {
          "kind": "source",
          "path": "program_digest"
        },
        "bindings_digest": {
          "kind": "source",
          "path": "bindings_digest"
        },
        "kind": {
          "kind": "provider",
          "provider": "definition",
          "paths": [],
          "rule": "固定published"
        },
        "content": {
          "kind": "provider",
          "provider": "definition",
          "paths": [
            "artifact_ref",
            "program_digest",
            "bindings_digest"
          ],
          "rule": "从固定发布制品重建完整源内容并核映射；不能取最新草稿，无法证明完整则整个投影不可用"
        },
        "metadata": {
          "kind": "provider",
          "provider": "definition",
          "paths": [
            "definition_id",
            "definition_version",
            "artifact_ref"
          ],
          "rule": "固定发布时metadata原件；不混当前可变metadata"
        },
        "proof_summaries": {
          "kind": "provider",
          "provider": "definition",
          "paths": [
            "artifact_ref",
            "program_digest",
            "bindings_digest"
          ],
          "rule": "原制品的全部可见证明摘要，不执行面板自报证明"
        }
      }
    },
    "RunView": {
      "source_model": "lifecycle__RunRecord",
      "relation": "完整run及同版本关联执行和活动槽快照",
      "fields": {
        "run_id": {
          "kind": "source",
          "path": "run_id"
        },
        "definition_id": {
          "kind": "source",
          "path": "definition_id"
        },
        "definition_version": {
          "kind": "source",
          "path": "definition_version"
        },
        "artifact_ref": {
          "kind": "source",
          "path": "artifact_ref"
        },
        "revision": {
          "kind": "source",
          "path": "revision"
        },
        "business_state": {
          "kind": "source",
          "path": "business_state"
        },
        "lifecycle": {
          "kind": "source",
          "path": "lifecycle"
        },
        "arm_generation": {
          "kind": "source",
          "path": "arm_generation"
        },
        "active_execution_id": {
          "kind": "source",
          "path": "active_execution_id"
        },
        "slot_revision": {
          "kind": "provider",
          "provider": "execution",
          "paths": [
            "definition_id",
            "definition_version"
          ],
          "rule": "从同快照ActivationSlot取当前修订，不能用run.revision代替；slot不再指该run时仍展示真实修订并阻止旧预检"
        },
        "transition_summary": {
          "kind": "provider",
          "provider": "execution",
          "paths": [
            "active_execution_id",
            "last_execution_id",
            "business_state"
          ],
          "rule": "由同run固定执行/状态提交记录生成，只读显示不驱动业务"
        },
        "execution_summary": {
          "kind": "provider",
          "provider": "execution",
          "paths": [
            "active_execution_id",
            "last_execution_id"
          ],
          "rule": "优先当前active，其次显式last；都不存在时null，不伪造pending"
        },
        "grant_summaries": {
          "kind": "provider",
          "provider": "targets",
          "paths": [
            "active_operation_id",
            "arm_generation"
          ],
          "rule": "读取当前run代次完整准备目标，分别保留baseline_grant_ref和target_grant_ref对应的可见grant_id；不得合并两代ID或用旧applied延续资格"
        }
      }
    },
    "PreflightView": {
      "source_model": "lifecycle__Preflight",
      "relation": "passed不是布防授权；目标零个的有效预检按领域规则，不能强行要求非空",
      "fields": {
        "run_id": {
          "kind": "source",
          "path": "run_id"
        },
        "run_revision": {
          "kind": "source",
          "path": "baseline.run_revision"
