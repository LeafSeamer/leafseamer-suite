{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafseamer.invalid/contracts/f06-f07/contracts.schema.json",
  "title": "F06/F07 候选资料 f06-f07/0.1.0-draft.1",
  "$defs": {
    "CatalogBinding": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "device_session_id": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "collection_ref": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "collection_generation": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Revision"
        },
        "catalog_revision": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Revision"
        },
        "binding_revision": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Revision"
        },
        "status": {
          "enum": [
            "unconfirmed",
            "ready",
            "changing",
            "stale"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scene_id": {
                "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
              },
              "obs_scene_uuid": {
                "type": "string",
                "format": "uuid"
              },
              "display_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "scene_id",
              "obs_scene_uuid",
              "display_name"
            ],
            "additionalProperties": false
          },
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "device_id",
        "device_session_id",
        "collection_ref",
        "collection_generation",
        "catalog_revision",
        "binding_revision",
        "status",
        "entries"
      ],
      "additionalProperties": false
    },
    "ObsEvidenceFrame": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "command_id": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "attempt_id": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "worker_boot_id": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "device_session_id": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "collection_generation": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Revision"
        },
        "catalog_revision": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Revision"
        },
        "protocol_request_id": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "kind": {
          "enum": [
            "set_send",
            "set_ack",
            "query_send",
            "query_result"
          ]
        },
        "io_seq": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Revision"
        },
        "tick_ns": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Revision"
        },
        "success": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "scene_uuid": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "evidence_id",
        "command_id",
        "attempt_id",
        "worker_boot_id",
        "device_session_id",
        "collection_generation",
        "catalog_revision",
        "protocol_request_id",
        "kind",
        "io_seq",
        "tick_ns",
        "success",
        "scene_uuid"
      ],
      "additionalProperties": false
    },
    "ObsCompletionBundle": {
      "type": "object",
      "properties": {
        "policy_id": {
          "const": "obs.program_scene.cut.v1"
        },
        "command_id": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "attempt_id": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "worker_boot_id": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "device_session_id": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "collection_generation": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Revision"
        },
        "catalog_revision": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Revision"
        },
        "target_scene_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "set_request_id": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "query_request_id": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObsEvidenceFrame"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "evaluation_tick_ns": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Revision"
        },
        "deadline_tick_ns": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Revision"
        },
        "max_query_age_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "catalog_current": {
          "type": "boolean"
        },
        "fixture_current": {
          "type": "boolean"
        },
        "durable": {
          "type": "boolean"
        }
      },
      "required": [
        "policy_id",
        "command_id",
        "attempt_id",
        "worker_boot_id",
        "device_session_id",
        "collection_generation",
        "catalog_revision",
        "target_scene_uuid",
        "set_request_id",
        "query_request_id",
        "frames",
        "evaluation_tick_ns",
        "deadline_tick_ns",
        "max_query_age_ms",
        "catalog_current",
        "fixture_current",
        "durable"
      ],
      "additionalProperties": false
    },
    "EffectFootprint": {
      "type": "object",
      "properties": {
        "action_ref": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
        },
        "manifest_digest": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Digest"
        },
        "semantics_revision": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Revision"
        },
        "complete": {
          "type": "boolean"
        },
        "reads": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[a-zA-Z0-9_.:-]+(/[a-zA-Z0-9_.:-]+)*$"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[a-zA-Z0-9_.:-]+(/[a-zA-Z0-9_.:-]+)*$"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "failure_writes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[a-zA-Z0-9_.:-]+(/[a-zA-Z0-9_.:-]+)*$"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[a-zA-Z0-9_.:-]+(/[a-zA-Z0-9_.:-]+)*$"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "safe_failure_classes": {
          "type": "array",
          "items": {
            "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Id"
          },
          "maxItems": 256,
          "uniqueItems": true
        }
      },
