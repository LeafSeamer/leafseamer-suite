        },
        "control_digest": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Digest"
        },
        "proof_bindings_digest": {
          "$ref": "https://leafseamer.invalid/contracts/first-loop.schema.json#/$defs/Digest"
