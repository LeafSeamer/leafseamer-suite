            "unavailable"
          ]
        },
        "evidence_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "observer_domain": {
          "$ref": "#/$defs/ClockRef"
        },
        "observed_tick": {
          "$ref": "#/$defs/U20"
        }
      },
      "required": [
        "request",
        "result",
        "evidence_id",
        "observer_domain",
        "observed_tick"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_id": {
                "$ref": "#/$defs/Id"
              }
            }
          },
          "else": {
            "properties": {
              "evidence_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
