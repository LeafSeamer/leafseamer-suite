        },
        "checks": {
          "kind": "provider",
          "provider": "targets",
          "paths": [
            "checks"
          ],
          "rule": "保留passed/failed/unknown，隐藏目标使确认所需完整预览不可用，不能将unknown改为false后丢语义"
        },
        "remaining_ms": {
          "kind": "provider",
          "provider": "deadline",
          "paths": [
            "clock",
            "issued_tick_ns",
            "expires_tick_ns"
          ],
          "rule": "同域剩余期限仅展示，不能签发UTC时间或授权"
        },
        "assessment_handle": {
          "kind": "provider",
          "provider": "handle",
          "paths": [
            "preflight_id",
            "preflight_digest",
            "baseline"
          ],
          "rule": "固定原预检+run/slot+会话/激活，不重复刷新期限"
        }
      }
    },
    "RecoveryPlanView": {
      "source_model": "lifecycle__RecoveryPreview",
      "relation": "固定preview的完整计划，最多4096项，超预算整体不可用不截断",
      "fields": {
        "run_id": {
          "kind": "source",
          "path": "run_id"
        },
        "prior_execution_id": {
          "kind": "source",
          "path": "prior_execution_id"
