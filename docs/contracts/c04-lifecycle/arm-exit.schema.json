{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafseamer.invalid/design/c04-lifecycle/arm-exit.schema.json",
  "title": "arm-exit/0.1.0-draft.1",
  "x-approved": false,
  "not": {},
  "$defs": {
    "StopIntent": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "arm-exit/0.1.0-draft.1"
        },
        "arm_operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "request_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "actor": {
          "type": "object",
          "properties": {
            "principal_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
            }
          },
          "required": [
            "principal_id"
          ],
          "additionalProperties": false
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "expected_run_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
        },
        "reason": {
          "enum": [
            "operator_cancel",
            "preparation_failed",
            "source_fault",
            "authorization_lost",
            "time_unqualified",
            "storage_recovered"
          ]
        }
      },
      "required": [
        "contract_version",
        "arm_operation_id",
        "request_epoch",
        "actor",
        "idempotency_key",
        "expected_run_revision",
        "reason"
      ],
      "additionalProperties": false
    },
    "RetryIntent": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "arm-exit/0.1.0-draft.1"
        },
        "arm_operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "request_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "actor": {
          "type": "object",
          "properties": {
            "principal_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
            }
          },
          "required": [
            "principal_id"
          ],
          "additionalProperties": false
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "previous_plan_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "reason": {
          "const": "proof_invalidated"
        }
      },
      "required": [
        "contract_version",
        "arm_operation_id",
        "request_epoch",
        "actor",
        "idempotency_key",
        "previous_plan_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "ObservationPin": {
      "type": "object",
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "status_revision": {
          "const": "1"
        },
        "observation_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "target_id",
        "status_revision",
        "observation_digest"
      ],
      "additionalProperties": false
    },
    "ExitResult": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "arm-exit/0.1.0-draft.1"
        },
        "arm_operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "generation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
        },
        "plan_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "run_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
        },
        "state": {
          "const": "paused"
        },
        "resources_cleared": {
          "const": false
        },
        "budget_released": {
          "const": false
        },
        "observations": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ObservationPin"
          }
        }
      },
      "required": [
        "contract_version",
        "arm_operation_id",
        "run_id",
        "generation",
        "plan_id",
        "run_revision",
        "state",
        "resources_cleared",
        "budget_released",
        "observations"
      ],
      "additionalProperties": false
    }
  }
}
