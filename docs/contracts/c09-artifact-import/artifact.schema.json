              }
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "$ref": "#/$defs/ArtifactIntakeReceipt"
              }
            }
          },
          "else": {
            "properties": {
              "receipt": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "VerifyMaterialization": {
