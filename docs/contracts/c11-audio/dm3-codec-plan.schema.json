{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:leafseamer:design:dm3-codec-review:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version","status","runtime_approved","source_inventory_sha256","groups"],
  "properties": {
    "format_version": {"const": "dm3-codec-review/1"},
    "status": {"const": "candidate_only"},
    "runtime_approved": {"const": false},
    "source_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "groups": {
      "type": "array", "minItems": 1, "maxItems": 184,
      "items": {"$ref": "#/$defs/Group"}
    }
  },
  "$defs": {
    "Group": {
      "type": "object", "additionalProperties": false,
      "required": ["id","family","source_indices","value_projection","units","redaction","runtime_approved"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"},
        "family": {"enum": ["integer_decimal","text_bytes_candidate","binary_unresolved","secret_ref_candidate","text_or_enum_unresolved","scene_absolute","scene_relative","meter_hex_candidate"]},
        "source_indices": {"type": "array", "minItems": 1, "maxItems": 184, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 2102}},
        "value_projection": {"enum": ["raw_integer","unresolved","secret_ref_only","scene_reference","direction","raw_meter"]},
        "units": {"enum": ["unqualified","not_applicable"]},
        "redaction": {"enum": ["standard","no_value_capture"]},
        "runtime_approved": {"const": false}
      }
    }
  }
}
