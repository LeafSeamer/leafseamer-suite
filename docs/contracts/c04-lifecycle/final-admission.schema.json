      "required": [
        "kind",
        "command_ref",
        "attempt_ref",
        "cancellation_ref",
        "execution_ref",
        "requester",
        "origin",
        "source_ref"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ordinary"
              }
            }
          },
          "then": {
            "properties": {
              "attempt_ref": {
                "$ref": "#/$defs/Ref"
              },
              "cancellation_ref": {
                "type": "null"
              },
              "execution_ref": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "attempt_ref": {
                "type": "null"
              },
              "cancellation_ref": {
                "$ref": "#/$defs/Ref"
              },
              "execution_ref": {
                "$ref": "#/$defs/Ref"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "automation"
              }
            }
          },
          "then": {
            "properties": {
              "requester": {
                "properties": {
                  "kind": {
                    "const": "service"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "requester": {
                "properties": {
                  "kind": {
                    "const": "human"
                  }
                }
              }
            }
          }
        }
      ]
    },
